# ============ PostDocX Backend Settings ============
# Copy these into Railway → Variables (one by one)

# --- Claude (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Routine work (discovery, verification, outreach): fast and economical
CLAUDE_MODEL=claude-sonnet-4-6
# High-stakes writing (proposals, interview briefings, two-body dossier, weekly review)
PREMIUM_MODEL=claude-opus-4-8

# --- Google Sheet database (required) ---
SHEET_ID=paste-the-long-id-from-your-sheet-url
GOOGLE_SERVICE_EMAIL=postdocx@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Gmail sending + reply detection (required for email) ---
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=16-character-app-password
OWNER_EMAIL=your.email@gmail.com
FROM_NAME=Dr. Waseem Abbas

# --- Mode: "approval" (default, safest) or "auto" ---
SEND_MODE=approval

# --- Safety caps ---
MAX_EMAILS_PER_DAY=5
# Autonomous conversation replies per day (auto mode)
MAX_REPLIES_PER_DAY=10
MAX_DISCOVER_PER_RESEARCHER=5
MAX_VERIFY_PER_RUN=6
FOLLOWUP_DAYS=8
MAX_FOLLOWUPS=2

# --- Search regions ---
REGIONS=Europe (EU country-by-country + UK), USA, Canada, Gulf (UAE, Saudi Arabia, Qatar)

# --- v2 portal (required) ---
# Long random secret: signs login sessions and encrypts users' Gmail app passwords
APP_SECRET=make-a-different-long-random-secret
# Google Drive folder for uploaded documents: create a folder in your Drive,
# share it with the service account email as Editor, paste its ID from the URL
DRIVE_FOLDER_ID=paste-drive-folder-id

# --- Server / links ---
BASE_URL=https://your-app.up.railway.app
APPROVE_KEY=make-a-long-random-secret-here
TZ_NAME=Asia/Karachi
CRON_MAIN=0 6 * * *
CRON_EVENING=0 18 * * *
CRON_BACKUP=30 8 * * 0
# Cost estimate rates (USD per million tokens) used in the daily report
COST_IN_PER_M=3
COST_OUT_PER_M=15
