# ============ PostDocX Backend Settings ============
# Copy these into Railway → Variables (one by one)

# --- Claude (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google Sheet database (required) ---
SHEET_ID=paste-the-long-id-from-your-sheet-url
GOOGLE_SERVICE_EMAIL=postdocx@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Gmail sending + reply detection (required for email) ---
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=16-character-app-password
OWNER_EMAIL=your.email@gmail.com
FROM_NAME=Dr. Waseem Abbas

# --- Mode: "approval" (default, safest) or "auto" ---
SEND_MODE=approval

# --- Safety caps ---
MAX_EMAILS_PER_DAY=5
MAX_DISCOVER_PER_RESEARCHER=5
MAX_VERIFY_PER_RUN=6
FOLLOWUP_DAYS=8
MAX_FOLLOWUPS=2

# --- Search regions ---
REGIONS=Europe (EU country-by-country + UK), USA, Canada, Gulf (UAE, Saudi Arabia, Qatar)

# --- Server / links ---
BASE_URL=https://your-app.up.railway.app
APPROVE_KEY=make-a-long-random-secret-here
TZ_NAME=Asia/Karachi
CRON_MAIN=0 6 * * *
CRON_EVENING=0 18 * * *
