{
  "manifest_version": 3,
  "name": "ForiForeign Apply Assistant",
  "version": "1.6.0",
  "description": "Opens the official application portal and fills your prepared details, with your permission. You always attach documents and press Submit yourself.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://foriforeign.com/*",
    "https://www.foriforeign.com/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://mail.yahoo.com/*",
    "https://compose.mail.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://foriforeign.com/*",
        "https://www.foriforeign.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "adapters/gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*"
      ],
      "js": [
        "adapters/outlook.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.yahoo.com/*",
        "https://compose.mail.yahoo.com/*"
      ],
      "js": [
        "adapters/yahoo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ForiForeign Apply Assistant"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}